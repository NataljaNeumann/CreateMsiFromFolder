<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CreateMsiFromFolder" Language="1033" Version="1.0.8.0" Manufacturer="NataljaNeumann@gmx.de" UpgradeCode="B0C7BFBE-4F66-4C6D-B6A4-3A77A7A8F5A2" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of CreateMsiFromFolder has already been installed." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="PublisherFolder" Name="NataljaNeumann">
          <Directory Id="INSTALLFOLDER" Name="CreateMsiFromFolder" />
        </Directory>
      </Directory>
    </Directory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WindowsMenuFolder" Name="CreateMsiFromFolder" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.CreateMsiFromFolder.TargetDir)license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="LicenseComponent" Guid="A6D8F3DE-3C2A-4C70-9A2D-1C4E3D1A8B5F">
        <File Id="LicenseFile" Source="$(var.CreateMsiFromFolder.TargetDir)license.txt" KeyPath="yes" />
      </Component>
      <Component Id="_" Guid="E94CE521-1170-4BB2-80C3-971822225B6E">
        <File Id="CreateMsiFromFolder_exe_config" Source="$(var.CreateMsiFromFolder.TargetDir)CreateMsiFromFolder.exe.config" />
        <File Id="license_rtf" Source="$(var.CreateMsiFromFolder.TargetDir)license.rtf" />
        <File Id="CreateMsiFromFolder_exe" Source="$(var.CreateMsiFromFolder.TargetDir)CreateMsiFromFolder.exe" KeyPath="yes">
        </File>
        <File Id="source_code_tar_zip" Source="$(var.CreateMsiFromFolder.TargetDir)source_code.tar.zip" />
		<Environment Id="AddInstallFolderToPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
	  </Component>
    </DirectoryRef>
    <DirectoryRef Id="WindowsMenuFolder">
      <Component Id="WindowsMenuShortcuts" Guid="2845423E-CAE2-492A-BF59-1519B4ED5465">
        <Shortcut Id="StartMenuShortcut" Directory="WindowsMenuFolder" Name="CreateMsiFromFolder" Target="[INSTALLFOLDER]CreateMsiFromFolder.exe" WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="CreateMsiFromFolder" Target="[INSTALLFOLDER]CreateMsiFromFolder.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveWindowsMenuFolder" Directory="WindowsMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\NataljaNeumann\CreateMsiFromFolder" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="MainFeature" Title="CreateMsiFromFolder" Level="1">
      <ComponentRef Id="_" />
      <ComponentRef Id="LicenseComponent" />
      <ComponentRef Id="WindowsMenuShortcuts" />
    </Feature>
  </Package>
</Wix>